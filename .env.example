# Скопируй этот файл в .env и заполни своими значениями.
# .env в git не попадает (см. .gitignore) - там держи реальный адрес сервера.

# Адрес сервера. Обязателен для запуска (index.js/index-cmd.js упадут
# с понятной ошибкой, если не задан).
MC_HOST=

# Порт необязателен: если пусто - minecraft-protocol сам сделает SRV-запрос
# _minecraft._tcp.<MC_HOST>. Задавай, только если сервер слушает
# нестандартный порт без SRV-записи.
MC_PORT=

# Имя бота (сервер offline-mode, поэтому это просто логин, без пароля).
MC_USERNAME=Builder

# Версия протокола - используется только для логов/fallback (реальное
# согласование версии всегда автоматическое, см. lib/connect.js).
MC_VERSION=1.12.2
